# Django application settings. Copy these into your shell or deployment environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Razorpay server API credentials (use Test Mode keys during development).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-secret

# Leave POSTGRES_DB unset to use the repository's local SQLite database.
# POSTGRES_DB=instabazaar
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
